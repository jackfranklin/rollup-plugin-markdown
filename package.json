{
  "name": "@jackfranklin/rollup-plugin-markdown",
  "version": "0.5.0",
  "description": "Parse markdown files and import them with Rollup",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./md": {
      "types": "./src/md.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackfranklin/rollup-plugin-markdown.git"
  },
  "keywords": [
    "markdown",
    "rollup",
    "rollup-plugin"
  ],
  "author": "Jack Franklin",
  "license": "MIT",
  "contributors": [
    "Tommy Mitchell (https://tommymitchell.io)"
  ],
  "peerDependencies": {
    "rollup": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "rollup": "^4.65.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.5.1",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3"
  }
}
